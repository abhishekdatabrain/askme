# Server Configuration
PORT=5000
NODE_ENV=production

# PostgreSQL Connection Configuration (Neon / Supabase / Render Postgres)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_SSL=true
SCHEMA=Abhishek

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=1d

FRONTEND_URL=https://askme.databrainit.com

# Database Timezone (e.g. Asia/Kolkata or +05:30 for IST)
DB_TIMEZONE=Asia/Kolkata
