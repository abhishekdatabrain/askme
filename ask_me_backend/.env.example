# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ask_me_db

# Or full connection URI if using external PG host (e.g. Supabase, Render, Neon)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ask_me_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=30d
